
/* Игра 8885A — сбалансированный вариант правил.
   Отличия от 8885.rule и обоснование — см. ChangeLog.md.
   Конечная жизнь (UPDATE0.md): параметры подобраны так, чтобы партии были
   длинными, а численность видов колебалась (см. SIMS.md). */

Базовые виды: Красный, Синий, Белый, Чёрный, Жёлтый;

Синонимы: {
	Красный x Синий ~ Фиолетовый;
	Красный x Жёлтый ~ Оранжевый;
	Красный x Белый ~ Розовый;
	Красный x Чёрный ~ Бордовый;
	Синий x Жёлтый ~ Зелёный;
	Синий x Белый ~ Голубой;
	Синий x Чёрный ~ Тёмно-синий;
	Жёлтый x Белый ~ Светло-жёлтый;
	Жёлтый x Чёрный ~ Коричневый;
	Белый x Чёрный ~ Серый;
}

/* Параметры: порог победы снижен (150), чтобы партии чаще завершались
   победой вида, а не только переполнением поля; награда за убийство и
   штраф за размножение — конечная жизнь. */
Параметры: {
	Поле: 888;
	Начало: 5;
	Победа: 150;
	Изнасилование: 40%;
	Максимум шагов: 0;
	Награда за убийство: 10%;
	Штраф за размножение: 18%;
}

Цвета: {
	Красный ~ #d34747;
	Синий ~ #365d8a;
	Белый ~ #f3f3f3;
	Чёрный ~ #8f8f8f;
	Жёлтый ~ #d9c03c;
	Фиолетовый ~ #503c91;
	Оранжевый ~ #e8913b;
	Розовый ~ #f57ba3;
	Бордовый ~ #8f0d0d;
	Зелёный ~ #7ca924;
	Голубой ~ #76b8b8;
	Тёмно-синий ~ #24527a;
	Светло-жёлтый ~ #e6df8b;
	Коричневый ~ #8b5a2b;
	Серый ~ #c0c0c0;
}

/* Действия.
   Белый: «20% ~смешанные~» — убивает «смешанных» с вероятностью 20%. */
Действия: {
	Красный: 0%;
	Синий: 50%;
	Белый: 20% ~смешанные~;
	Чёрный: 30%;
	Жёлтый: 40%;
	*: 0%;
}

/* Конечная жизнь: смертность при рождении и долголетие (шкала L; каждый
   ход вероятность смерти растёт на 1/L, ожидаемая продолжительность жизни
   свободного чибика примерно sqrt(pi*L/2) ходов). */
Смертность: {
	Красный: 3%;
	Синий: 5%;
	Белый: 4%;
	Чёрный: 5%;
	Жёлтый: 5%;
	*: 5%;
}

Долголетие: {
	Красный: 80;
	Синий: 60;
	Белый: 70;
	Чёрный: 60;
	Жёлтый: 65;
	*: 70;
}

/* Вероятность успеха попытки убийства (по видам). */
Успех убийства: {
	Красный: 100%;
	Синий: 60%;
	Белый: 70%;
	Чёрный: 50%;
	Жёлтый: 60%;
	*: 60%;
}

/* Потомство: распределение числа детей за одно размножение
   (0 — без потомства, штраф за размножение не применяется). */
Потомство: {
	Красный: 0: 40% 1: 60%;
	Синий: 0: 40% 1: 60%;
	Белый: 0: 40% 1: 60%;
	Чёрный: 0: 40% 1: 60%;
	Жёлтый: 0: 40% 1: 60%;
	*: 0: 40% 1: 60%;
}

/* Партнёры.
   Белый размножается и со своими, и с чистыми видами (иначе его чистое
   размножение даёт ему неустранимое преимущество). */
Партнёры: {
	Красный: [*] -> [];
	Синий: [Синий, Белый, Жёлтый, Красный] -> [*];
	Белый: [Белый, ~чистый~] -> [];
	Чёрный: [Чёрный, ~гибрид~] -> [];
	Жёлтый: [Жёлтый, Красный] -> [*];
	*: [~я~, ~родители~] -> [*];
}

/* Убийство.
   Чёрный и Жёлтый могут убивать и своих (чёрный — кроме своих гибридов):
   это ограничивает рост вида-лидера (зависимость от плотности). */
Убийство: {
	Синий: ~доминирующий~ кроме Синий, Зелёный, Голубой;
	Белый: ~смешанные~ кроме Белый;
	Чёрный: * кроме Тёмно-синий, Коричневый, Бордовый, Серый;
	Жёлтый: *;
}

/* Симпатии: белый соглашается с чистыми всегда (с гибридами — никогда);
   согласие синих, чёрных и жёлтых снижено, чтобы размножение не было
   слишком «бесплатным» и партии длились дольше. */
Симпатии: {
	* < Красный: 100%;
	~гибрид~ < Белый: 0%;
	* < Белый: 100%;
	~гибрид~ < Чёрный: 80%;
	* < Чёрный: 40%;
	* < Жёлтый: 60%;
	Белый < Синий: 80%;
	Жёлтый < Синий: 80%;
	Красный < Синий: 40%;
	X < (X, *): 100%;
}

/* Рождение: гибрид 30%, родители по 35% (в оригинале 50/25/25) — чистые
   виды меньше разбавляются гибридами. Жёлтый с красным даёт оранжевого
   с 60% (сдерживание жёлтых). */
Рождение: {
	Красный < Синий -> Фиолетовый: 30% Красный: 35% Синий: 35%;
	Красный < Жёлтый -> Оранжевый: 60% Красный: 20% Жёлтый: 20%;
	Красный < Белый -> Розовый: 30% Красный: 35% Белый: 35%;
	Красный < Чёрный -> Бордовый: 30% Красный: 35% Чёрный: 35%;
	Синий < Жёлтый -> Зелёный: 30% Синий: 35% Жёлтый: 35%;
	Синий < Белый -> Голубой: 30% Синий: 35% Белый: 35%;
	Синий < Чёрный -> Тёмно-синий: 30% Синий: 35% Чёрный: 35%;
	Жёлтый < Белый -> Светло-жёлтый: 30% Жёлтый: 35% Белый: 35%;
	Жёлтый < Чёрный -> Коричневый: 30% Жёлтый: 35% Чёрный: 35%;
	Белый < Чёрный -> Серый: 30% Белый: 35% Чёрный: 35%;
	X < Y -> X: 50% Y: 50%;
}
