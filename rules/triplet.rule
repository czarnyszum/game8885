
/* Исходные виды */
Базовые виды: Красный, Синий;

/* Гибриды */
Синонимы: {
	Красный x Синий ~ Фиолетовый;
}

/* Параметры среды: размер поля, стартовое число, порог победы,
   вероятность изнасилования, лимит шагов (0 = без лимита),
   награда за убийство и штраф за размножение (конечная жизнь) */
Параметры: {
	Поле: 888;
	Начало: 10;
	Победа: 555;
	Изнасилование: 90%;
	Максимум шагов: 0;
	Награда за убийство: 5%;
	Штраф за размножение: 10%;
}

/* Цвета видов (для графика) */
Цвета: {
	Красный ~ #d34747;
	Синий ~ #365d8a;
	Фиолетовый ~ #503c91;
}

/* Вероятность выбрать убийство вместо размножения. */
Действия: {
	Красный: 50%;
	Синий: 40%;
	Фиолетовый: 33%;
}

/* Конечная жизнь: смертность при рождении (вероятность умереть в конце
   первого же хода) и долголетие (шкала L: каждый ход вероятность смерти
   растёт на 1/L; ожидаемая продолжительность жизни свободного чибика
   примерно sqrt(pi*L/2) ходов). */
Смертность: {
	Красный: 2%;
	Синий: 2%;
	Фиолетовый: 2%;
	*: 2%;
}

Долголетие: {
	Красный: 200;
	Синий: 200;
	Фиолетовый: 200;
	*: 200;
}

/* Вероятность успеха попытки убийства (по видам). */
Успех убийства: {
	Красный: 60%;
	Синий: 60%;
	Фиолетовый: 60%;
	*: 60%;
}

/* Потомство: распределение числа детей за одно размножение (0 — без
   потомства, штраф не применяется). */
Потомство: {
	Красный: 0: 20% 1: 60% 2: 20%;
	Синий: 0: 20% 1: 60% 2: 20%;
	Фиолетовый: 0: 20% 1: 60% 2: 20%;
	*: 0: 20% 1: 60% 2: 20%;
}

/* Предпочтения при выборе партнёра (когда чибик инициатор).
   [предпочтительные] -> [запасные]; условие в скобках ограничивает запасных. */
Партнёры: {
	Красный: [Красный] -> [*];
	Синий: [Синий] -> [Фиолетовый];
	Фиолетовый: [Фиолетовый] -> [*];
}

/* Кого можно убивать. */
Убийство: {
        Красный: ~доминирующий~; 
	Синий: ~доминирующий~;
 	Фиолетовый: *;
}

/* Симпатии: вероятность, что ПРИНИМАЮЩАЯ сторона согласится.
   Форма: Инициатор < Принимающий: вероятность.
   Свои всегда согласны (100%) — это встроенное правило. */
Симпатии: {
	* < Фиолетовый:100%;
	Фиолетовый < Синий: 100%;
	Красный < Синий: 100%;
	Фиолетовый < Красный: 25%;
	Синий < Красный: 50%;
}

/* Рождение: два исходных вида дают 50% гибрида и по 25% каждого родителя;
   во всех остальных случаях потомок — цвет одного из родителей (50/50). */
Рождение: {
	Красный < Синий -> Фиолетовый: 100%;
	Красный < Фиолетовый -> Фиолетовый: 50% Красный: 50%;
	Синий < Фиолетовый -> Фиолетовый: 50% Синий: 50%;
}
