
/* Исходные виды */
Базовые виды: Красный, Синий;

/* Гибриды */
Синонимы: {
	Красный x Синий ~ Фиолетовый;
}

/* Параметры среды: размер поля, стартовое число, порог победы,
   вероятность изнасилования, лимит шагов (0 = без лимита),
   награда за убийство и штраф за размножение (конечная жизнь). */
Параметры: {
	Поле: 888;
	Начало: 10;
	Победа: 555;
	Изнасилование: 50%;
	Максимум шагов: 0;
	Награда за убийство: 10%;
	Штраф за размножение: 22%;
}

/* Цвета видов (для графика) */
Цвета: {
	Красный ~ #d34747;
	Синий ~ #365d8a;
	Фиолетовый ~ #503c91;
}

/* Вероятность выбрать убийство вместо размножения. */
Действия: {
	Красный: 20%;
	Синий: 20%;
	Фиолетовый: 20%;
}

/* Конечная жизнь: смертность при рождении (вероятность умереть в конце
   первого же хода) и долголетие (шкала L: каждый ход вероятность смерти
   растёт на 1/L; ожидаемая продолжительность жизни свободного чибика
   примерно sqrt(pi*L/2) ходов). */
Смертность: {
	Красный: 5%;
	Синий: 5%;
	Фиолетовый: 5%;
	*: 5%;
}

Долголетие: {
	Красный: 60;
	Синий: 60;
	Фиолетовый: 60;
	*: 60;
}

/* Вероятность успеха попытки убийства (по видам). */
Успех убийства: {
	Красный: 50%;
	Синий: 50%;
	Фиолетовый: 50%;
	*: 50%;
}

/* Потомство: распределение числа детей за одно размножение (0 — без
   потомства, штраф не применяется). */
Потомство: {
	Красный: 0: 45% 1: 55%;
	Синий: 0: 45% 1: 55%;
	Фиолетовый: 0: 45% 1: 55%;
	*: 0: 45% 1: 55%;
}

/* Предпочтения при выборе партнёра (когда чибик инициатор).
   Все виды размножаются и со своими, и с другими цветами — иначе
   смешанные пары не образуются и гибрид (Фиолетовый) никогда не
   появляется (см. SIMS.md). */
Партнёры: {
	Красный: [Красный, Синий] -> [*];
	Синий: [Синий, Красный] -> [*];
	Фиолетовый: [Фиолетовый, Красный, Синий] -> [*];
}

/* Кого можно убивать. Красные и синие убивают доминирующий вид — это
   сдерживает лидера и перемешивает состав популяции. */
Убийство: {
        Красный: ~доминирующий~; 
	Синий: ~доминирующий~;
 	Фиолетовый: *;
}

/* Симпатии: вероятность, что ПРИНИМАЮЩАЯ сторона согласится.
   Свои всегда согласны (100%) — это встроенное правило; здесь все
   согласны со всеми — размножение ограничено только конечной жизнью. */
Симпатии: {
	* < Красный: 100%;
	* < Синий: 100%;
	* < Фиолетовый: 100%;
}

/* Рождение: смешанная пара даёт 50% гибрида и по 25% каждого родителя
   (правило 4 OriginalRules.md); гибрид с родительским цветом — 50/50. */
Рождение: {
	Красный < Синий -> Фиолетовый: 50% Красный: 25% Синий: 25%;
	Красный < Фиолетовый -> Фиолетовый: 50% Красный: 50%;
	Синий < Фиолетовый -> Фиолетовый: 50% Синий: 50%;
}
