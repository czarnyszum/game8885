
/* Пример правил (маленькая версия игры 8885) */

Базовые виды: Красный, Синий;

Синонимы: {
	Красный x Синий ~ Фиолетовый;
}

Параметры: {
	Поле: 100;
	Начало: 5;
	Победа: 60;
	Изнасилование: 50%;
	Максимум шагов: 1000;
}

Цвета: {
	Красный ~ #d34747;
	Синий ~ #365d8a;
	Фиолетовый ~ #503c91;
}

Действия: {
	Красный: 0%;
	Синий: 30%;
	Фиолетовый: 10%;
}

Партнёры: {
	Красный: [*] -> [];
	Синий: [Синий] -> [*];
	*: [~я~] -> [*];
}

Убийство: {
	Синий: * кроме Синий, Фиолетовый;
	Фиолетовый: * кроме Фиолетовый, Красный, Синий;
}

Симпатии: {
	* < Красный: 100%;
	* < Синий: 50%;
	X < (X, *): 100%;
}

Рождение: {
	Красный < Синий -> Фиолетовый: 50% Красный: 25% Синий: 25%;
	X < Y -> X: 50% Y: 50%;
}
