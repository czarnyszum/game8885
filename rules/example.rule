
/* Пример правил (маленькая версия игры 8885) */

Базовые виды: Красный, Синий;

Синонимы: {
	Красный x Синий ~ Фиолетовый;
}

Параметры: {
	Поле: 100;
	Начало: 5;
	Победа: 60;
	Изнасилование: 50%;
	Максимум шагов: 1000;
	Награда за убийство: 10%;
	Штраф за размножение: 20%;
}

Цвета: {
	Красный ~ #d34747;
	Синий ~ #365d8a;
	Фиолетовый ~ #503c91;
}

Действия: {
	Красный: 30%;
	Синий: 30%;
	Фиолетовый: 10%;
}

Смертность: {
	Красный: 4%;
	Синий: 4%;
	Фиолетовый: 4%;
	*: 4%;
}

Долголетие: {
	Красный: 60;
	Синий: 60;
	Фиолетовый: 60;
	*: 60;
}

Успех убийства: {
	Красный: 60%;
	Синий: 60%;
	Фиолетовый: 60%;
	*: 60%;
}

Потомство: {
	Красный: 0: 40% 1: 60%;
	Синий: 0: 40% 1: 60%;
	Фиолетовый: 0: 40% 1: 60%;
	*: 0: 40% 1: 60%;
}

Партнёры: {
	Красный: [Красный] -> [*];
	Синий: [Синий] -> [*];
	*: [~я~] -> [*];
}

Убийство: {
	Красный: Синий;
	Синий: * кроме Синий, Фиолетовый;
	Фиолетовый: * кроме Фиолетовый, Красный, Синий;
}

Симпатии: {
	* < Красный: 100%;
	* < Синий: 50%;
	X < (X, *): 100%;
}

Рождение: {
	Красный < Синий -> Фиолетовый: 50% Красный: 25% Синий: 25%;
	X < Y -> X: 50% Y: 50%;
}
