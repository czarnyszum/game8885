
/* Правила игры 8885 (OriginalRules.md) */

/* Исходные виды */
Базовые виды: Красный, Синий, Белый, Чёрный, Жёлтый;

/* Гибриды */
Синонимы: {
	Красный x Синий ~ Фиолетовый;
	Красный x Жёлтый ~ Оранжевый;
	Красный x Белый ~ Розовый;
	Красный x Чёрный ~ Бордовый;
	Синий x Жёлтый ~ Зелёный;
	Синий x Белый ~ Голубой;
	Синий x Чёрный ~ Тёмно-синий;
	Жёлтый x Белый ~ Светло-жёлтый;
	Жёлтый x Чёрный ~ Коричневый;
	Белый x Чёрный ~ Серый;
}

/* Параметры среды: размер поля, стартовое число, порог победы,
   вероятность изнасилования, лимит шагов (0 = без лимита),
   награда за убийство и штраф за размножение (конечная жизнь) */
Параметры: {
	Поле: 888;
	Начало: 5;
	Победа: 555;
	Изнасилование: 50%;
	Максимум шагов: 0;
	Награда за убийство: 5%;
	Штраф за размножение: 10%;
}

/* Цвета видов (для графика) */
Цвета: {
	Красный ~ #d34747;
	Синий ~ #365d8a;
	Белый ~ #f3f3f3;
	Чёрный ~ #8f8f8f;
	Жёлтый ~ #d9c03c;
	Фиолетовый ~ #503c91;
	Оранжевый ~ #e8913b;
	Розовый ~ #f57ba3;
	Бордовый ~ #8f0d0d;
	Зелёный ~ #7ca924;
	Голубой ~ #76b8b8;
	Тёмно-синий ~ #24527a;
	Светло-жёлтый ~ #e6df8b;
	Коричневый ~ #8b5a2b;
	Серый ~ #c0c0c0;
}

/* Вероятность выбрать убийство вместо размножения.
   Белые: убивают только тех, кто только что размножился с чужим цветом. */
Действия: {
	Красный: 0%;
	Синий: 15%;
	Белый: ~смешанные~;
	Чёрный: 10%;
	Жёлтый: 30%;
	*: 0%;
}

/* Конечная жизнь: смертность при рождении и долголетие (шкала L; каждый
   ход вероятность смерти растёт на 1/L, ожидаемая продолжительность жизни
   свободного чибика примерно sqrt(pi*L/2) ходов). */
Смертность: {
	Красный: 1%;
	Синий: 2%;
	Белый: 2%;
	Чёрный: 2%;
	Жёлтый: 2%;
	*: 2%;
}

Долголетие: {
	Красный: 150;
	Синий: 120;
	Белый: 180;
	Чёрный: 120;
	Жёлтый: 130;
	*: 150;
}

/* Вероятность успеха попытки убийства (по видам). */
Успех убийства: {
	Красный: 100%;
	Синий: 70%;
	Белый: 80%;
	Чёрный: 60%;
	Жёлтый: 70%;
	*: 70%;
}

/* Потомство: распределение числа детей за одно размножение
   (0 — без потомства, штраф за размножение не применяется). */
Потомство: {
	Красный: 0: 20% 1: 60% 2: 20%;
	Синий: 0: 20% 1: 60% 2: 20%;
	Белый: 0: 20% 1: 60% 2: 20%;
	Чёрный: 0: 20% 1: 60% 2: 20%;
	Жёлтый: 0: 20% 1: 60% 2: 20%;
	*: 0: 20% 1: 60% 2: 20%;
}

/* Предпочтения при выборе партнёра (когда чибик инициатор).
   [предпочтительные] -> [запасные]; условие в скобках ограничивает запасных. */
Партнёры: {
	Красный: [*] -> [];
	Синий: [Синий, Белый, Жёлтый] -> [*];
	Белый: [Белый] -> [~чистый~] [Белый < 5];
	Чёрный: [Чёрный, ~гибрид~] -> [];
	Жёлтый: [Жёлтый, Красный] -> [*];
	*: [~я~, ~родители~] -> [*];
}

/* Кого можно убивать. */
Убийство: {
	Синий: ~доминирующий~ кроме Синий, Зелёный, Голубой;
	Белый: ~смешанные~ кроме Белый;
	Чёрный: * кроме Чёрный, Тёмно-синий, Коричневый, Бордовый, Серый;
	Жёлтый: * кроме Жёлтый, Белый;
}

/* Симпатии: вероятность, что ПРИНИМАЮЩАЯ сторона согласится.
   Форма: Инициатор < Принимающий: вероятность.
   Свои всегда согласны (100%) — это встроенное правило. */
Симпатии: {
	* < Красный: 100%;
	~гибрид~ < Белый: 0%;
	* < Белый: 80% [Белый < 5];
	* < Белый: 0%;
	~гибрид~ < Чёрный: 100%;
	* < Чёрный: 50%;
	* < Жёлтый: 100%;
	Белый < Синий: 100%;
	Жёлтый < Синий: 100%;
	Красный < Синий: 50%;
	X < (X, *): 100%;
}

/* Рождение: два исходных вида дают 50% гибрида и по 25% каждого родителя;
   во всех остальных случаях потомок — цвет одного из родителей (50/50). */
Рождение: {
	Красный < Синий -> Фиолетовый: 50% Красный: 25% Синий: 25%;
	Красный < Жёлтый -> Оранжевый: 50% Красный: 25% Жёлтый: 25%;
	Красный < Белый -> Розовый: 50% Красный: 25% Белый: 25%;
	Красный < Чёрный -> Бордовый: 50% Красный: 25% Чёрный: 25%;
	Синий < Жёлтый -> Зелёный: 50% Синий: 25% Жёлтый: 25%;
	Синий < Белый -> Голубой: 50% Синий: 25% Белый: 25%;
	Синий < Чёрный -> Тёмно-синий: 50% Синий: 25% Чёрный: 25%;
	Жёлтый < Белый -> Светло-жёлтый: 50% Жёлтый: 25% Белый: 25%;
	Жёлтый < Чёрный -> Коричневый: 50% Жёлтый: 25% Чёрный: 25%;
	Белый < Чёрный -> Серый: 50% Белый: 25% Чёрный: 25%;
	X < Y -> X: 50% Y: 50%;
}
