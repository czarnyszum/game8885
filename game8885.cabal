-- game8885 — zero-player simulation "Игра 8885"

name:                game8885
version:             0.1.0.0
license:             MIT
license-file:        LICENSE
author:              czarnyszum
maintainer:          czarnyszum@gmail.com
build-type:          Simple
extra-source-files:  ChangeLog.md, README.md
cabal-version:       >=1.10

library
  hs-source-dirs:      src
  exposed-modules:
                      Cmd
                      Ctx
                      Decl
                      MainPage
                      Pattern
                      Parser
                      Probability.Distribution
                      Probability.Sample
                      Server
                      Sim
                      Species
  build-depends:
                aeson,
                array >= 0.5.6.0,
                base,
                blaze-html,
                bytestring >= 0.11.5.3,
                containers,
                directory,
                filepath,
                lens,
                mtl,
                parsec,
                random >= 1.2.1.2,
                snap-blaze,
                snap-core,
                snap-server,
                text,
                websockets,
                websockets-snap
  default-language:    Haskell2010
  ghc-options:         -O2 -Wall -threaded -rtsopts "-with-rtsopts=-N"

executable game8885
  main-is:             Main.hs
  hs-source-dirs:      src
  build-depends:
                base,
                game8885
  default-language:    Haskell2010
  ghc-options:         -O2 -Wall -threaded -rtsopts "-with-rtsopts=-N"

executable game8885-test
  main-is:             TestMain.hs
  hs-source-dirs:      src
  build-depends:
                base,
                game8885
  default-language:    Haskell2010
  ghc-options:         -O2 -Wall -threaded -rtsopts
